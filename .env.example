# Copie para .env e substitua os placeholders. Nunca versione credenciais reais.
ENV=development
AUTH_PROVIDER=mock
LOG_LEVEL=info
ALLOWED_ORIGINS=*

# Fonte de dados do módulo de pacientes
PACIENTE_PROVIDER_TYPE=CSV
APP_DB_URL=sqlite+aiosqlite:///data/app.db
POSTGRES_DSN=postgresql+asyncpg://usuario:senha@host:5432/banco
ORACLE_DSN=oracle+oracledb://usuario:senha@host:1521/servico

# Segredo JWT: substitua por valor aleatório forte fora dos ambientes locais.
JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO
JWT_EXP_HOURS=24
REFRESH_TOKEN_EXP_DAYS=30

# O provedor mock é exclusivo de development/test. O provedor institucional
# será definido e implementado futuramente pelo TI do HC, sem protocolo pré-selecionado.
