ENV=development
AUTH_PROVIDER=mock
LOG_LEVEL=info
ALLOWED_ORIGINS=*

# Fonte de dados do módulo de pacientes
PACIENTE_PROVIDER_TYPE=CSV

# CSV de solicitações do AGHU, mantido fora do Git
SOLICITACAO_CSV_PATH=data/privado/solicitacoes.csv

APP_DB_URL=sqlite+aiosqlite:///data/app.db

# Provedor mock exclusivo para desenvolvimento/testes
AP_REQUEST_PROVIDER=mock
AP_REQUEST_FIXTURE=demo
AP_MOCK_REQUESTS_AVAILABLE=true

POSTGRES_DSN=postgresql+asyncpg://usuario:senha@host:5432/banco
ORACLE_DSN=oracle+oracledb://usuario:senha@host:1521/servico

JWT_SECRET=SUBSTITUA_POR_SEGREDO_ALEATORIO
JWT_EXP_HOURS=24
REFRESH_TOKEN_EXP_DAYS=30