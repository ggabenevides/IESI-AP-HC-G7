# ==============================================================================
# FRONTEND (Vite) — MODELO DE VARIÁVEIS DE AMBIENTE
# ==============================================================================
# Copie para `frontend/.env.local` (ignorado pelo Git) e ajuste.
# Apenas variáveis com prefixo VITE_ ficam visíveis no navegador: NUNCA coloque
# segredos aqui.
# ==============================================================================

# Fonte das solicitações AGHU exibidas na Recepção.
#   mock -> dados fictícios do seed (padrão)
#   api  -> GET /api/solicitacoes (CSV do HC servido pelo backend); casos,
#           devoluções e não conformidades continuam no mock
VITE_AP_FONTE_SOLICITACOES=mock

# Quantidade máxima de solicitações carregadas da API (o backend aceita até 1000).
VITE_AP_SOLICITACOES_LIMITE=200

# Opcional: carrega apenas solicitações a partir desta data (AAAA-MM-DD).
VITE_AP_SOLICITACOES_DATA_INICIO=
